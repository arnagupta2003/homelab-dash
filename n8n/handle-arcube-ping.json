{
  "name": "Handle ARCUBE & Service Pings to Slack",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "arcube-ping",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000001",
      "name": "Receive Service Ping",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        224
      ],
      "webhookId": "arcube-ping-webhook-001"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "val-origin",
              "name": "origin",
              "type": "string",
              "value": "={{ String($('Receive Service Ping').item.json.body?.origin ?? $('Receive Service Ping').item.json.origin ?? 'arcube').trim().toLowerCase().slice(0, 60) }}"
            },
            {
              "id": "val-name",
              "name": "name",
              "type": "string",
              "value": "={{ String($('Receive Service Ping').item.json.body?.name ?? $('Receive Service Ping').item.json.name ?? '').trim().slice(0, 120) }}"
            },
            {
              "id": "val-service",
              "name": "service",
              "type": "string",
              "value": "={{ String($('Receive Service Ping').item.json.body?.service ?? $('Receive Service Ping').item.json.service ?? 'General').trim().slice(0, 120) }}"
            },
            {
              "id": "val-message",
              "name": "message",
              "type": "string",
              "value": "={{ String($('Receive Service Ping').item.json.body?.message ?? $('Receive Service Ping').item.json.message ?? '').trim().slice(0, 2000) }}"
            },
            {
              "id": "val-valid",
              "name": "valid",
              "type": "boolean",
              "value": "={{ (() => { const src = $('Receive Service Ping').item.json.body ?? $('Receive Service Ping').item.json; const honey = String(src.website ?? '').trim(); const name = String(src.name ?? '').trim(); const msg = String(src.message ?? '').trim(); return honey.length === 0 && name.length > 0 && msg.length > 0; })() }}"
            },
            {
              "id": "val-error",
              "name": "validationError",
              "type": "string",
              "value": "={{ (() => { const src = $('Receive Service Ping').item.json.body ?? $('Receive Service Ping').item.json; if (String(src.website ?? '').trim().length > 0) return 'Spam check failed.'; if (!String(src.name ?? '').trim()) return 'Name is required.'; if (!String(src.message ?? '').trim()) return 'Message is required.'; return ''; })() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-2222-4000-8000-000000000002",
      "name": "Validate Ping Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        224
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{ $('Validate Ping Payload').item.json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-3333-4000-8000-000000000003",
      "name": "Is Payload Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        448,
        224
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "list",
          "value": "C0CKYS8P2PQ",
          "cachedResultName": "SELECT-YOUR-KANEO-CHANNEL"
        },
        "text": "={{ `[${$('Validate Ping Payload').item.json.origin}] ${$('Validate Ping Payload').item.json.service} - from ${$('Validate Ping Payload').item.json.name}\\n\\n${$('Validate Ping Payload').item.json.message}\\n\\n---\\nOrigin: ${$('Validate Ping Payload').item.json.origin} | Service: ${$('Validate Ping Payload').item.json.service} | Sender: ${$('Validate Ping Payload').item.json.name} | Time: ${$now.toFormat('yyyy-MM-dd HH:mm')}` }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "a1b2c3d4-4444-4000-8000-000000000004",
      "name": "Notify Slack Kaneo Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        704,
        128
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "slackApi": {
          "id": "7Y72pIhpzGp7zP4w",
          "name": "ARCUBE Bot Token"
        }
      },
      "onError": "continueErrorOutput",
      "notes": "Switch channelId in n8n UI to the Slack channel that triggers your Kaneo board workflow. Message includes [origin] tag (e.g. [arcube])."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, message: 'Message sent! Arnav has been pinged and it is on his board.' }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1b2c3d4-5555-4000-8000-000000000005",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        960,
        48
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'validation_error', message: $('Validate Ping Payload').item.json.validationError || 'Invalid input.' }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "a1b2c3d4-6666-4000-8000-000000000006",
      "name": "Respond Validation Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        704,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\":false,\"error\":\"internal_error\",\"message\":\"Could not send your message right now. Please try again in a minute.\"}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "a1b2c3d4-7777-4000-8000-000000000007",
      "name": "Respond Server Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        960,
        240
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Receive Service Ping": {
      "main": [
        [
          {
            "node": "Validate Ping Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Ping Payload": {
      "main": [
        [
          {
            "node": "Is Payload Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Payload Valid?": {
      "main": [
        [
          {
            "node": "Notify Slack Kaneo Channel",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Validation Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Slack Kaneo Channel": {
      "main": [
        [
          {
            "node": "Respond Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Server Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
