{
  "name": "Handle ARCUBE & Service Pings to Kaneo",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "arcube-ping",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "ac97ee32-8985-4fbf-a51e-06bc52613797",
      "name": "Receive Service Ping",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        176
      ],
      "webhookId": "arcube-ping-webhook-001"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "val-origin",
              "name": "origin",
              "type": "string",
              "value": "={{ String($('Receive Service Ping').item.json.body?.origin ?? $('Receive Service Ping').item.json.origin ?? 'arcube').trim().toLowerCase().slice(0, 60) }}"
            },
            {
              "id": "val-name",
              "name": "name",
              "type": "string",
              "value": "={{ String($('Receive Service Ping').item.json.body?.name ?? $('Receive Service Ping').item.json.name ?? '').trim().slice(0, 120) }}"
            },
            {
              "id": "val-service",
              "name": "service",
              "type": "string",
              "value": "={{ String($('Receive Service Ping').item.json.body?.service ?? $('Receive Service Ping').item.json.service ?? 'General').trim().slice(0, 120) }}"
            },
            {
              "id": "val-message",
              "name": "message",
              "type": "string",
              "value": "={{ String($('Receive Service Ping').item.json.body?.message ?? $('Receive Service Ping').item.json.message ?? '').trim().slice(0, 2000) }}"
            },
            {
              "id": "val-valid",
              "name": "valid",
              "type": "boolean",
              "value": "={{ (() => { const src = $('Receive Service Ping').item.json.body ?? $('Receive Service Ping').item.json; const honey = String(src.website ?? '').trim(); const name = String(src.name ?? '').trim(); const msg = String(src.message ?? '').trim(); return honey.length === 0 && name.length > 0 && msg.length > 0; })() }}"
            },
            {
              "id": "val-error",
              "name": "validationError",
              "type": "string",
              "value": "={{ (() => { const src = $('Receive Service Ping').item.json.body ?? $('Receive Service Ping').item.json; if (String(src.website ?? '').trim().length > 0) return 'Spam check failed.'; if (!String(src.name ?? '').trim()) return 'Name is required.'; if (!String(src.message ?? '').trim()) return 'Message is required.'; return ''; })() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c5f4fef0-0124-4089-9868-296627d224f3",
      "name": "Validate Ping Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        176
      ]
    },
    {
      "parameters": {
        "conditions": {
          "combinator": "and",
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-valid",
              "leftValue": "={{ $('Validate Ping Payload').item.json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "77995d85-13a8-4ad1-a95b-654ddd7f1007",
      "name": "Is Payload Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [
        448,
        176
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://kanban.bizad.in/api/task/fvxzsbqgof89albgazeylb6j",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_KANEO_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ projectId: 'fvxzsbqgof89albgazeylb6j', columnId: 'zniq7qobiefctev3swn5o90j', title: '[' + $('Validate Ping Payload').item.json.origin + '] ' + $('Validate Ping Payload').item.json.service + ' - from ' + $('Validate Ping Payload').item.json.name, description: $('Validate Ping Payload').item.json.message + '\\n\\n---\\nOrigin: ' + $('Validate Ping Payload').item.json.origin + '\\nService: ' + $('Validate Ping Payload').item.json.service + '\\nSender: ' + $('Validate Ping Payload').item.json.name + '\\nTime: ' + $now.toFormat('yyyy-MM-dd HH:mm'), status: 'to-do', priority: 'medium' }) }}",
        "options": {}
      },
      "id": "a9728549-d3a6-4cd5-b534-31c41346ff92",
      "name": "Create Kaneo Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        688,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "personal-inbox",
          "mode": "name"
        },
        "text": "={{ 'Added to Kaneo: [' + $('Validate Ping Payload').item.json.origin + '] ' + $('Validate Ping Payload').item.json.service + ' - from ' + $('Validate Ping Payload').item.json.name + '\\n' + $('Validate Ping Payload').item.json.message }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "b1c2d3e4-5555-4000-8000-000000000009",
      "name": "Ping personal-inbox",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        928,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "slackApi": {
          "id": "7Y72pIhpzGp7zP4w",
          "name": "ARCUBE Bot Token"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Drops a short heads-up in #personal-inbox. Non-blocking so Kaneo + 200 OK still succeed if Slack blips."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, message: 'Message sent! It is now on Arnav\\'s board.', taskId: $('Create Kaneo Task').item.json.id ?? null }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "f783d2ea-aa70-43a6-af00-baea37240d91",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1168,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'validation_error', message: $('Validate Ping Payload').item.json.validationError || 'Invalid input.' }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "d06d94cf-a9b0-4fc5-9933-7f68a0542b1a",
      "name": "Respond Validation Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        688,
        288
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\":false,\"error\":\"internal_error\",\"message\":\"Could not send your message right now. Please try again in a minute.\"}",
        "options": {
          "responseCode": 500
        }
      },
      "id": "41dfd02a-ed0d-4049-83b1-a80da0be6e63",
      "name": "Respond Server Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        928,
        224
      ]
    }
  ],
  "pinData": {},
